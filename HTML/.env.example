# Copie este arquivo para ".env" e coloque os valores reais.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Senha do usuário avnadmin do banco no Aiven
DB_PASSWORD=coloque_a_senha_do_banco_aqui

# Segredo usado pelo express-session para assinar o cookie da sessão.
# Use um texto longo e aleatório. Para gerar um, rode no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_por_um_texto_longo_e_aleatorio
