<%- include('partials/header') %>

<h2>Cadastro de Produtos</h2>
<form action="/admin" method="POST">

<label for="produtoNome">Nome do Produto:</label><br>
<input type="text" id="produtoNome" name="produtoNome"><br><br>

<label for="produtoCategoria">Categoria do Produto:</label><br>
<input type="text" id="produtoCategoria" name="produtoCategoria"><br><br>

<label for="produtoEstoque">Estoque do Produto:</label><br>
<input type="number" id="produtoEstoque" name="produtoEstoque"><br><br>

<label for="produtoPreco">Preço do Produto:</label><br>
<input type="number" id="produtoPreco" name="produtoPreco"><br><br>

<label for="produtoFornecedorIDFK">Fornecedor:</label><br>
<select id="produtoFornecedorIDFK" name="produtoFornecedorIDFK" required>
    <option value="">Selecione...</option>
    <% fornecedores.forEach(f => { %>
        <option value="<%= f.fornecedorID %>"><%= f.fornecedorNome %></option>
    <% }) %>
</select><br><br>

<button type="submit">Salvar</button>
</form>

<%- include('partials/footer') %>
