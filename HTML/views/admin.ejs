<%- include('partials/header') %>

<h2>Cadastro de Produtos</h2>
<form action="/admin" method="POST">

<label for="produtoNome">Nome do Produto:</label><br>
<input type="text" id="produtoNome" name="produtoNome"><br><br>

<label for="produtoFoto">Foto do Produto:</label><br>
<input type="text" id="produtoFoto" name="produtoFoto"><br><br>

<label for="produtoCategoria">Categoria do Produto:</label><br>
<input type="text" id="produtoCategoria" name="produtoCategoria"><br><br>

<label for="produtoEstoque">Estoque do Produto:</label><br>
<input type="number" id="produtoEstoque" name="produtoEstoque"><br><br>

<label for="produtoPreco">Preço do Produto:</label><br>
<input type="number" step="0.01" id="produtoPreco" name="produtoPreco"><br><br>

<label for="produtoFornecedorIDFK">Fornecedor:</label><br>
<select id="produtoFornecedorIDFK" name="produtoFornecedorIDFK" required>
    <option value="">Selecione...</option>
    <% fornecedores.forEach(f => { %>
        <option value="<%= f.fornecedorID %>"><%= f.fornecedorNome %></option>
    <% }) %>
</select><br><br>

<button type="submit">Salvar</button>
</form>

<h2>Produtos cadastrados</h2>
<table>
<tr>
<th>Nome</th>
<th>Foto</th>
<th>Categoria</th>
<th>Preço</th>
<th>Estoque</th>
<th>Ações</th>
</tr>
<% produtos.forEach(p => { %>
<tr>
<td><%= p.produtoNome %></td>
<td>
<% if (p.produtoFoto) { %>
<img src="<%= p.produtoFoto %>" alt="" width="60">
<% } %>
</td>
<td><%= p.produtoCategoria %></td>
<td>R$ <%= p.produtoPreco %></td>
<td><%= p.produtoEstoque %></td>
<td>
<a href="/admin/produto/<%= p.produtoID %>/editar">Editar</a>

<form action="/admin/produto/<%= p.produtoID %>/excluir" method="POST" style="display:inline">
<button type="submit">Excluir</button>
</form>
</td>
</tr>
<% }) %>
</table>

<h2>Usuários</h2>
<table>
<tr><th>E-mail</th><th>Tipo</th><th>Ação</th></tr>
<% usuarios.forEach(u => { %>
<tr>
<td><%= u.usuarioEmail %></td>
<td><%= u.usuarioTipo %></td>
<td>
<% if (u.usuarioID !== locals.usuario.id) { %>
<form action="/admin/usuario/<%= u.usuarioID %>/tipo" method="POST">
<input type="hidden" name="tipo" value="<%= u.usuarioTipo === 'admin' ? 'cliente' : 'admin' %>">
<button type="submit"><%= u.usuarioTipo === 'admin' ? 'Tornar cliente' : 'Tornar admin' %></button>
</form>
<% } %>
</td>
</tr>
<% }) %>
</table>

<%- include('partials/footer') %>
