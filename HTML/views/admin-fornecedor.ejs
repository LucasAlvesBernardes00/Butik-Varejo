<%- include('partials/header') %>

<h2>Cadastro de Fornecedores</h2>
<form action="/admin/fornecedor" method="POST">

<label for="fornecedorNome">Nome do Fornecedor:</label><br>
<input type="text" id="fornecedorNome" name="fornecedorNome" required><br><br>

<label for="fornecedorCnpj">CNPJ:</label><br>
<input type="text" id="fornecedorCnpj" name="fornecedorCnpj" required><br><br>

<label for="fornecedorTelefone">Telefone:</label><br>
<input type="text" id="fornecedorTelefone" name="fornecedorTelefone" required><br><br>

<button type="submit">Salvar</button>
</form>

<%- include('partials/footer') %>